# Lahgtna Arabic TTS Prototype — environment template.
# Copy to .env and edit if needed. NEVER commit .env.
#
# This app needs NO API key for its one model (oddadmix/lahgtna-omnivoice-v2
# downloads anonymously from Hugging Face Hub on first run). HF_TOKEN below
# is optional and only raises the Hub's anonymous download rate limit.

# --- Optional: Hugging Face token (raises anonymous download rate limit) ---
HF_TOKEN=

# --- Optional: OpenAI API key, only needed for the automatic AI dialect
# rewrite step (backend/app/services/dialect_rewriter.py). When set, every
# /api/tts (and avatar) generation automatically rewrites/diacritizes the
# text for the chosen dialect via OpenAI first — no per-request field to
# turn it on, and it never fires from typing/dialect selection alone, only
# from an actual generation call. Leaves that feature reported as
# unavailable via /api/model-info when unset (silently skipped, not an
# error); nothing else in the app depends on it. Never touches TTS
# synthesis itself.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Model / device ---
MODEL_REPO_ID=oddadmix/lahgtna-omnivoice-v2
DEVICE=auto
# Where downloaded model weights are cached (defaults to ./.hf_cache).
HF_HOME=

# --- Service configuration ---
REQUEST_TIMEOUT_S=120.0
MAX_INPUT_CHARS=2000
MAX_REFERENCE_AUDIO_BYTES=15728640

# --- Talking Avatar feature (all optional — every field below already has a
# sensible repo-local default; see docs/AVATAR_SETUP.md for what each does) ---
# Real AI lip sync (SadTalker via Replicate) when set — real, metered cost
# (~$0.09-0.15/generation). Unset falls back to the free, non-AI
# StubAvatarEngine automatically; nothing else in the app depends on it.
REPLICATE_API_TOKEN=
AVATAR_STORAGE_DIR_OVERRIDE=
MAX_PORTRAIT_BYTES=8388608
AVATAR_MAX_CONCURRENT_JOBS=1
AVATAR_MAX_QUEUED_JOBS=10
AVATAR_FPS=25
AVATAR_MAX_AUDIO_S=120.0
AVATAR_JOB_TIMEOUT_S=300.0
AVATAR_CLEANUP_INTERVAL_S=900.0
AVATAR_JOB_RETENTION_S=86400.0
