# Lahgtna Arabic TTS Prototype — environment template.
# Copy to .env and edit if needed. NEVER commit .env.
#
# This app needs NO API key for its one model (oddadmix/lahgtna-omnivoice-v2
# downloads anonymously from Hugging Face Hub on first run). HF_TOKEN below
# is optional and only raises the Hub's anonymous download rate limit.

# --- Optional: Hugging Face token (raises anonymous download rate limit) ---
HF_TOKEN=

# --- Model / device ---
MODEL_REPO_ID=oddadmix/lahgtna-omnivoice-v2
DEVICE=auto
# Where downloaded model weights are cached (defaults to ./.hf_cache).
HF_HOME=

# --- Service configuration ---
REQUEST_TIMEOUT_S=120.0
MAX_INPUT_CHARS=2000
MAX_REFERENCE_AUDIO_BYTES=15728640
