# Arabic TTS Prototype — environment template.
# Copy to .env and fill in. NEVER commit .env (FR-039).
# The default provider (edge) needs NO credentials; the prototype runs without this file.

# --- Azure AI Speech (optional) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- ElevenLabs (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Service configuration ---
TTS_DEFAULT_PROVIDER=edge
TTS_FALLBACK_PROVIDER=edge
TTS_REQUEST_TIMEOUT_S=30.0
TTS_MAX_INPUT_CHARS=5000
