# Arabic TTS Prototype — environment template.
# Copy to .env and fill in. NEVER commit .env (FR-039).
# The default provider (edge) needs NO credentials; the prototype runs without this file.

# --- Groq / Orpheus Arabic (Saudi dialect) (optional) ---
GROQ_API_KEY=

# --- ElevenLabs (optional) ---
# The key needs BOTH `text_to_speech` and `voices_read` permissions (set when
# creating the key in the ElevenLabs dashboard) — a key with only
# `text_to_speech` can still hit 402 on voices not already in your account's
# own library; `voices_read` lets this project confirm which voices actually
# work before using them (docs/TTS_EVALUATION.md).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Hugging Face (optional) ---
# Hosted Inference API token — gates dialect detection, diacritization, G2P,
# and any Hugging Face TTS candidate (research.md R10-R14). Same optional,
# credential-gated pattern as Groq/ElevenLabs above: absent means those
# specific capabilities report themselves unavailable and the system falls
# back to the existing Edge/Groq/ElevenLabs path — nothing crashes or
# requires this to run. Create a token at https://huggingface.co/settings/tokens
# (read-only scope is sufficient for Inference API calls).
HF_TOKEN=

# --- Service configuration ---
TTS_DEFAULT_PROVIDER=edge
TTS_FALLBACK_PROVIDER=edge
TTS_REQUEST_TIMEOUT_S=30.0
TTS_MAX_INPUT_CHARS=5000
